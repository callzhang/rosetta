{
  "name": "rosetta-annotation-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && npm run test:build",
    "dev": "vite --host 127.0.0.1 --port 4174",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:render": "node --max-old-space-size=6144 --experimental-vm-modules --import tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "test:build": "node --import tsx --test tests/build/*.test.ts",
    "test:server": "node --import tsx --test tests/smoke/*.test.ts"
  },
  "dependencies": {
    "@ant-design/icons": "5.0.0",
    "@codemirror/lang-json": "6.0.1",
    "@msgpack/msgpack": "3.1.2",
    "@stardustai/annotation-client": "file:vendor/stardustai-annotation-client-0.1.0.tgz",
    "@uiw/codemirror-theme-atomone": "4.21.24",
    "@uiw/react-codemirror": "4.21.24",
    "@volcengine/tos-sdk": "2.9.1",
    "ahooks": "3.7.1",
    "ali-oss": "6.23.0",
    "antd": "5.23.0",
    "axios": "0.35.0",
    "classnames": "2.3.1",
    "esdk-obs-browserjs": "3.25.6",
    "file-selector": "2.1.2",
    "i18next": "21.9.1",
    "idb": "7.0.2",
    "idb-keyval": "6.2.0",
    "ky": "1.14.0",
    "lodash": "4.17.21",
    "mobx": "6.7.0",
    "mobx-react": "7.6.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-dropzone": "14.3.8",
    "uuid": "8.3.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "7.19.0",
    "@babel/plugin-transform-class-properties": "7.22.0",
    "@testing-library/dom": "10.4.1",
    "@types/jsdom": "21.1.7",
    "@types/lodash": "4.14.185",
    "@types/node": "22.20.5",
    "@types/react": "18.0.19",
    "@types/react-dom": "18.0.6",
    "@types/uuid": "8.3.4",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.4",
    "jsdom": "26.1.0",
    "tailwindcss": "3.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  },
  "engines": {
    "node": ">=22.13 <23 || >=24"
  },
  "overrides": {
    "@volcengine/tos-sdk": {
      "axios": "$axios"
    },
    "axios-adapter-uniapp": {
      "axios": "$axios"
    },
    "esdk-obs-browserjs": {
      "axios": "$axios"
    }
  }
}
